rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isAuthenticated() &&
        request.auth.token != null &&
        request.auth.token.email != null && (
          request.auth.token.email == 'admin@picklepoint.com' ||
          request.auth.token.email.matches('(?i)admin@picklepoint\\.com')
        );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        isPrimaryAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isClientAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client_admin'
      );
    }

    function isFacilityManager() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isClientAdmin() || isFacilityManager();
    }

    // Helper: Identifies if a request attempts to modify subscription parameters
    function isModifyingSubscription() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionPlan',
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'trialExpiresAt',
        'isTrialClient'
      ]);
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      allow read, write: if true;
    }

    // ==========================================
    // 2. Companies & Subcollections
    // ==========================================
    match /companies/{companyId} {
      allow read: if true;
      
      // Super Admins can edit anything; Client Admins can edit profile except subscription fields
      allow create: if isSuperAdmin() || (!isModifyingSubscription() && (isAdmin() || isAuthenticated()));
      allow update: if isSuperAdmin() || (!isModifyingSubscription() && (isAdmin() || isAuthenticated()));
      allow delete: if isSuperAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }
    }

    // ==========================================
    // 3. Courts
    // ==========================================
    match /courts/{courtId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 4. Bookings
    // ==========================================
    match /bookings/{bookingId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 5. Vouchers
    // ==========================================
    match /vouchers/{voucherId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 6. Settings (Global & Per-User Checkout Settings)
    // ==========================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin() || isAuthenticated();
      }
    }

    // ==========================================
    // 7. Open Play Events & Registrations & Subcollection Chat
    // ==========================================
    match /openplay_events/{eventId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /openplay_registrations/{registrationId} {
      allow read, write: if true;
    }

    // ==========================================
    // 8. Notifications & Reminders
    // ==========================================
    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ==========================================
    // 9. Client Admin Invitations
    // ==========================================
    match /invitations/{invitationId} {
      allow read, write: if true;
    }

    // ==========================================
    // 10. URL Shortener / Short Links
    // ==========================================
    match /short_links/{linkId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    // ==========================================
    // 11. Client Venue Subscription Leads
    // ==========================================
    match /client_leads/{leadId} {
      allow read, write: if true;
    }

    // ==========================================
    // 12. Scoreboard & Live Matches
    // ==========================================
    match /scoreboards/{scoreboardId} {
      allow read, write: if true;
    }
  }
}
